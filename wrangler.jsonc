{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "neolesk",
    "main": "src/worker/index.ts",
    "compatibility_date": "2026-08-23",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*",
            "/mcp/*",
            "/render/*",
            "/s/*",
            "/config.json"
        ]
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "SESSION_CELL",
                "class_name": "SessionCell"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["SessionCell"]
        }
    ],
    "vars": {
        "KROKI_ORIGIN": "http://kroki-main.kroki.svc.cluster.local:8080/"
    }
}
