    "scripts": {
        "examples:cache": "node scripts/generate-example-cache.cjs",
        "prestart": "npm run examples:cache",
        "start": "vite",
        "build": "vite build",
        "prepare:worker": "node scripts/prepare-worker-assets.mjs",
        "prebundle:worker": "npm run prepare:worker",
        "bundle:worker": "node scripts/bundle-worker.mjs",
        "prepreview": "npm run examples:cache",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "pretest": "npm run prepare:worker",
        "pretest:worker": "npm run prepare:worker",
        "test:worker": "node scripts/verify-worker-start.mjs",
        "test:corpus": "playwright test",
        "test:corpus:update": "playwright test --update-snapshots",
        "test:watch": "vitest",
        "prebuild": "npm run examples:cache",
        "predeploy": "npm run prepare:worker && npm run build",
        "deploy": "celld deploy ."
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
